{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Lint (SwiftLint)",
      "type": "shell",
      "command": "swiftlint lint --quiet",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "swiftlint",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Swift: Build (Xcode)",
      "type": "shell",
      "command": "xcodebuild -project Gleis.xcodeproj -scheme Gleis -configuration Debug build 2>&1 | xcbeautify || xcodebuild -project Gleis.xcodeproj -scheme Gleis -configuration Debug build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "xcodebuild",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Swift: Build & Lint",
      "dependsOn": ["Swift: Build (Xcode)", "Swift: Lint (SwiftLint)"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Swift: Clean Build",
      "type": "shell",
      "command": "xcodebuild -project Gleis.xcodeproj -scheme Gleis clean build 2>&1 | xcbeautify || xcodebuild -project Gleis.xcodeproj -scheme Gleis clean build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "xcodebuild",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Swift: Format (SwiftFormat)",
      "type": "shell",
      "command": "swiftformat .",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
