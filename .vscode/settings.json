{
  // ============================================
  // SWIFT EXTENSION (Official - 2026)
  // ============================================
  // Extension: "Swift" by swiftlang (swiftlang.swift-vscode)
  // https://marketplace.visualstudio.com/items?itemName=swiftlang.swift-vscode
  // This is the official Swift extension from the Swift.org team

  // Background compilation for real-time errors
  "swift.backgroundCompilation": true,

  // Diagnostics configuration
  "swift.diagnosticsCollection": "keepAll",
  "swift.diagnosticsStyle": "llvm",

  // Swift testing
  "swift.testEnvironmentVariables": {},

  // ============================================
  // SOURCEKIT-LSP (Language Server)
  // ============================================
  // Auto-detected from toolchain - no manual configuration needed
  // The extension automatically uses SourceKit-LSP from your Swift toolchain

  // Enable background indexing for better performance
  "swift.sourcekit-lsp.backgroundIndexing": "on",

  // Enable additional diagnostics for unused code detection
  "swift.sourcekit-lsp.serverArguments": [
    "--experimental-feature",
    "diagnostics"
  ],

  // ============================================
  // CODE FORMATTING - SWIFTFORMAT
  // ============================================
  // Extension: vknabel.vscode-swiftformat
  // Requires: brew install swiftformat
  // Config: .swiftformat

  // ============================================
  // CODE LINTING - SWIFTLINT
  // ============================================
  // Extension: vknabel.vscode-swiftlint
  // Requires: brew install swiftlint
  // Config: .swiftlint.yml

  // Run SwiftLint on save for inline warnings
  "swiftlint.enable": true,
  "swiftlint.autoLintWorkspace": true,
  // Visual styling for unnecessary/unused code (when detected by language server)
  "workbench.colorCustomizations": {
    "editorUnnecessaryCode.border": "#dd7aab",
    "editorUnnecessaryCode.opacity": "#00000077"
  },
  // Fade out unused code
  "editor.showUnused": true,

  // Run SwiftLint analyze mode for unused declarations (requires build)
  // Note: This is slower but catches unused variables/functions
  "swiftlint.toolchainPath": "",
  "swiftlint.path": "/opt/homebrew/bin/swiftlint",

  // ============================================
  // EDITOR SETTINGS FOR SWIFT
  // ============================================
  "[swift]": {
    // Format on save using SwiftFormat
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vknabel.vscode-swiftformat",

    // Code actions on save
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },

    // Indentation: 4 spaces (Swift standard)
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    // Editor behavior
    "editor.trimAutoWhitespace": true,
    "editor.rulers": [120],
    "editor.wordWrap": "off",

    // IntelliSense settings
    "editor.suggest.insertMode": "replace",
    "editor.suggestSelection": "first",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false
    },
    "editor.snippetSuggestions": "top",
    "editor.inlineSuggest.enabled": true,

    // Visual enhancements
    "editor.semanticHighlighting.enabled": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true
  },

  // ============================================
  // GLOBAL EDITOR SETTINGS
  // ============================================
  // Default indentation for all files
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  // ============================================
  // FILE ASSOCIATIONS
  // ============================================
  "files.associations": {
    "*.swift": "swift",
    "Package.swift": "swift",
    ".swift-format": "json",
    "*.plist": "xml",
    "*.entitlements": "xml",
    "*.xcconfig": "properties",
    "*.strings": "properties",
    "*.stringsdict": "xml"
  },

  // ============================================
  // FILES TO EXCLUDE FROM SEARCH/WATCHER
  // ============================================
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/xcuserdata": true,
    "**/.build": true,
    "**/build": true,
    "**/.swiftpm": true,
    "**/DerivedData": true,
    "**/*.xcodeproj/project.xcworkspace": true,
    "**/*.xcodeproj/xcuserdata": true
  },

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.build/**": true,
    "**/build/**": true,
    "**/DerivedData/**": true,
    "**/.swiftpm/**": true,
    "**/xcuserdata/**": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/build": true,
    "**/.build": true,
    "**/DerivedData": true,
    "**/.swiftpm": true,
    "**/xcuserdata": true,
    "**/*.xcodeproj/project.xcworkspace": true
  },

  // ============================================
  // FILE TRIMMING & CLEANUP
  // ============================================
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ============================================
  // PROBLEMS & DIAGNOSTICS
  // ============================================
  "problems.showCurrentInStatus": true,
  "problems.autoReveal": true,

  // ============================================
  // GIT INTEGRATION
  // ============================================
  "git.ignoreLimitWarning": true,
  "git.detectSubmodules": true,

  // ============================================
  // PERFORMANCE OPTIMIZATIONS
  // ============================================
  "files.autoSave": "onFocusChange",
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,

  // ============================================
  // BREADCRUMBS & NAVIGATION
  // ============================================
  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "on",

  // ============================================
  // TERMINAL
  // ============================================
  "terminal.integrated.env.osx": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:${env:PATH}"
  }
}
