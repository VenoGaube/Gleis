# SwiftFormat Configuration - Best Practices
# This configuration enforces modern Swift formatting conventions

# ============================================
# SWIFTFORMAT VERSION
# ============================================
--swiftversion 5.9

# ============================================
# FILE OPTIONS
# ============================================
--exclude Pods,Carthage,.build,build,DerivedData,vendor,fastlane,**/.build,**/Generated,**/Protobuf

# ============================================
# INDENTATION & SPACING
# ============================================
--indent 4
--indentcase false
--tabwidth 4
--xcodeindentation enabled
--smarttabs enabled
--ifdef indent

# ============================================
# LINE BREAKS & WRAPPING
# ============================================
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

# ============================================
# BRACES
# ============================================
--allman false
--elseposition same-line
--guardelse same-line
--emptybraces no-space

# ============================================
# SEMICOLONS & COMMAS
# ============================================
--semicolons inline
--commas inline

# ============================================
# OPERATORS
# ============================================
--operatorfunc spaced
--nospaceoperators ..<,...
--ranges spaced

# ============================================
# SPACING & WHITESPACE
# ============================================
--trimwhitespace always

# ============================================
# RETURN & VOID
# ============================================
--voidtype void

# ============================================
# SELF
# ============================================
--self init-only
--selfrequired @autoclosure,@escaping

# ============================================
# IMPORTS
# ============================================
--importgrouping testable-bottom

# ============================================
# HEADER
# ============================================
--header strip

# ============================================
# ATTRIBUTES
# ============================================
--typeattributes prev-line
--varattributes preserve

# ============================================
# MARKS
# ============================================
--marktypes always
--markextensions always
--extensionacl on-extension
--groupedextension MARK: %c + %t

# ============================================
# MODIFIERS
# ============================================
--modifierorder override,public,internal,fileprivate,private,static,class,final,required,convenience,lazy,dynamic,mutating,nonmutating,optional,indirect,infix,prefix,postfix

# ============================================
# ENABLED RULES
# ============================================
--enable sortImports
--enable extensionAccessControl
--enable markTypes

# Redundancy removal
--enable redundantSelf
--enable redundantType
--enable redundantInit
--enable redundantGet
--enable redundantPattern
--enable redundantLet
--enable redundantLetError
--enable redundantObjc
--enable redundantFileprivate
--enable redundantBackticks
--enable redundantBreak
--enable redundantNilInit
--enable redundantVoidReturnType
--enable redundantExtensionACL
--enable redundantRawValues

# Modernization
--enable preferKeyPath

# Safety
--enable strongifiedSelf
--enable typeSugar

# Readability
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable duplicateImports
--enable blankLinesAroundMark
--enable blankLinesAtEndOfScope
--enable blankLinesAtStartOfScope
--enable blankLinesBetweenScopes
--enable linebreakAtEndOfFile
--enable isEmpty
--enable void
--enable enumNamespaces
--enable hoistPatternLet
--enable wrapMultilineStatementBraces
--enable blockComments

# Unused code
--enable unusedArguments