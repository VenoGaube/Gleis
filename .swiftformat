# SwiftFormat Configuration - Minimal, Non-Intrusive
# Only fix obvious formatting issues, preserve developer intent

# ============================================
# SWIFTFORMAT VERSION
# ============================================
--swiftversion 5.9

# ============================================
# FILE OPTIONS
# ============================================
--exclude Pods,Carthage,.build,build,DerivedData,vendor,fastlane,**/.build,**/Generated,**/Protobuf

# ============================================
# INDENTATION & SPACING
# ============================================
--indent 4
--tabwidth 4
--xcodeindentation enabled

# ============================================
# LINE WRAPPING (Preserve existing)
# ============================================
--maxwidth none

# ============================================
# BRACES
# ============================================
--allman false
--elseposition same-line
--emptybraces no-space

# ============================================
# SEMICOLONS
# ============================================
--semicolons inline

# ============================================
# SPACING
# ============================================
--trimwhitespace always

# ============================================
# SELF (Minimal changes)
# ============================================
--self remove

# ============================================
# IMPORTS
# ============================================
--importgrouping testable-bottom

# ============================================
# HEADER
# ============================================
--header strip

# ============================================
# MINIMAL RULES (Only non-controversial fixes)
# ============================================

# Enable only safe, obvious fixes
--enable redundantReturn
--enable redundantNilInit
--enable redundantVoidReturnType
--enable duplicateImports
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable linebreakAtEndOfFile
--enable isEmpty
--enable void